# Copy to `.env`, fill in, then:  set -a; . examples/.env; set +a
# NEVER commit a filled-in .env (it is gitignored).

# --- tenant server -----------------------------------------------------------
# Either a server subdomain (e.g. mese) or a full base URL.
UNTIS_SERVER=mese
UNTIS_SCHOOL=demo-school

# --- credentials -------------------------------------------------------------
UNTIS_USER=demo
UNTIS_PASSWORD=demo

# Base32 TOTP secret from the QR code (web UI: profile -> show QR-code).
UNTIS_SECRET=

# Set to 1 for anonymous intern login (only public-timetable schools).
UNTIS_ANONYMOUS=

# JSON Web Token for the view REST API (see examples/python/04_mobile_jwt.py).
UNTIS_JWT=

# --- request defaults --------------------------------------------------------
# Public JSON-RPC uses YYYYMMDD; intern/view REST use YYYY-MM-DD.
UNTIS_START=20261005
UNTIS_END=20261011
UNTIS_ELEMENT_ID=
# STUDENT | CLASS | TEACHER | SUBJECT | ROOM
UNTIS_ELEMENT_TYPE=CLASS

# --- view REST extras --------------------------------------------------------
UNTIS_TENANT=
UNTIS_SCHOOL_YEAR=

# --- Platform / extern timetable API ----------------------------------------
UNTIS_API_URL=https://api.webuntis.com
UNTIS_API_TOKEN=
UNTIS_CLIENT_ID=
UNTIS_CLIENT_SECRET=
UNTIS_CLASS=
UNTIS_LIMIT=0
UNTIS_OFFSET=0
UNTIS_DATE_LAST_MODIFIED_AFTER=
